# Android Controller & Observation configuration
# Copy to .env and adjust. Never commit .env.

# ADB executable (name on PATH or absolute path)
ADB_PATH=adb

# Optional: pin a device/emulator serial. Leave empty to auto-select.
ANDROID_SERIAL=

# Optional AVD name used when launching an emulator
ANDROID_AVD=

# Optional emulator binary (defaults to "emulator" on PATH)
EMULATOR_PATH=emulator

# Timeouts (seconds)
DEFAULT_TIMEOUT=10
UI_SETTLE_TIMEOUT=5
UI_SETTLE_POLL_INTERVAL=0.25
DEVICE_WAIT_TIMEOUT=60
EMULATOR_BOOT_TIMEOUT=120

# Artifact directories (relative to the project root)
DATA_DIR=data
SCREENSHOT_DIR=data/screenshots
UI_TREE_DIR=data/ui_trees
OBSERVATION_DIR=data/observations

# Optional default APK / package (never required; CLI flags override)
APK_PATH=
PACKAGE_NAME=

# Set to 1/true to run without a real device (unit tests / CI)
ANDROID_MOCK=0
