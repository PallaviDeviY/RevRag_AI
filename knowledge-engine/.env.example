# Knowledge Engine (Member 3 - Sneha)
# Copy to .env and adjust. Never commit a real .env.

# SQLite database file. Created automatically if missing.
KNOWLEDGE_DB_PATH=data/knowledge.db

# Where generated Knowledge Pack JSON files are written.
KNOWLEDGE_PACK_OUTPUT_DIR=data/output

# DEBUG | INFO | WARNING | ERROR
KNOWLEDGE_LOG_LEVEL=INFO

# Base directory that relative screenshot_path / ui_tree_path values resolve
# against. Set this to wherever Pallavi's controller writes its artifacts.
KNOWLEDGE_MEDIA_ROOT=.

# Journey discovery safety limits (protect against huge / cyclic graphs).
KNOWLEDGE_MAX_JOURNEY_LENGTH=8
KNOWLEDGE_MAX_JOURNEYS=200
