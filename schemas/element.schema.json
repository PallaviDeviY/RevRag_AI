{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://revrag.ai/schemas/element.schema.json",
  "title": "UIElement",
  "description": "A single node from a UIAutomator dump. element_id is assigned in DFS order as element_000001.",
  "type": "object",
  "additionalProperties": true,
  "required": ["element_id", "type", "clickable", "enabled", "scrollable", "bounds"],
  "properties": {
    "element_id": { "type": "string", "pattern": "^element_[0-9]{6}$" },
    "type": { "type": "string" },
    "text": { "type": ["string", "null"] },
    "content_description": { "type": ["string", "null"] },
    "resource_id": { "type": ["string", "null"] },
    "clickable": { "type": "boolean" },
    "enabled": { "type": "boolean" },
    "scrollable": { "type": "boolean" },
    "focusable": { "type": "boolean" },
    "focused": { "type": "boolean" },
    "checked": { "type": "boolean" },
    "selected": { "type": "boolean" },
    "package": { "type": ["string", "null"] },
    "bounds": {
      "type": ["object", "null"],
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "integer" },
        "top": { "type": "integer" },
        "right": { "type": "integer" },
        "bottom": { "type": "integer" }
      }
    }
  }
}
